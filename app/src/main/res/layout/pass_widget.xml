<?xml version="1.0" encoding="utf-8"?>
<!--
  4x2 strip: logo plate, issuer and title on top, divider, validity and open pill below.
  No padding on the root: the glass bitmap fills the whole widget area.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pass_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/pass_widget_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/pass_widget_background"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="13dp">

        <!-- Main row: logo plate and text column. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/pass_widget_logo_plate"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/pass_widget_logo_plate">

                <ImageView
                    android:id="@+id/pass_widget_logo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@mipmap/icon"
                    android:scaleType="fitCenter"
                    android:contentDescription="Ticketlogo" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pass_widget_issuer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.035"
                    android:text="FossWallet"
                    android:textColor="#FFCFE3EE"
                    android:textSize="11sp" />

                <!-- Takes the remaining height and shrinks (down to 12sp) instead of breaking mid-word. -->
                <TextView
                    android:id="@+id/pass_widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical|start"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:textFontWeight="600"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.01"
                    android:hyphenationFrequency="normal"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="19sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:text="Ticket auswählen"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- A TextView divider is safe in RemoteViews (plain View is not). -->
        <TextView
            android:id="@+id/pass_widget_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#30FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/pass_widget_caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="DEIN TICKET"
                android:textColor="#FFD4E6F0"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/pass_widget_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/pass_widget_action_background"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Ticket öffnen  ↗"
                android:textColor="#FF193C53"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

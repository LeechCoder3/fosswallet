<?xml version="1.0" encoding="utf-8"?>
<!--
  2x2 card ("Ruhig"): logo plate and open arrow on top, title and issuer at the bottom.
  The root has no padding on purpose. The glass bitmap (see PassWidgetProvider) fills the
  complete area the launcher gives the widget; all spacing lives inside the card.
  Every id the provider touches exists in both widget layouts, because RemoteViews breaks
  on missing ids.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pass_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/pass_widget_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/pass_widget_background"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="13dp">

        <!-- Top row: logo plate on the left, round open arrow on the right. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <FrameLayout
                android:id="@+id/pass_widget_logo_plate"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/pass_widget_logo_plate">

                <ImageView
                    android:id="@+id/pass_widget_logo"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@mipmap/icon"
                    android:scaleType="fitCenter"
                    android:contentDescription="Ticketlogo" />
            </FrameLayout>

            <!-- Flexible spacer; a plain View is not allowed in RemoteViews before API 31. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/pass_widget_arrow_background">

                <TextView
                    android:id="@+id/pass_widget_action"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="↗"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp" />
            </FrameLayout>
        </LinearLayout>

        <!--
          Title: takes all remaining height and sits at the bottom. It shrinks (down to 11sp)
          instead of breaking inside a word; the provider adds soft hyphens at compound seams
          so "Deutschland-" / "semesterticket" breaks where a reader expects it.
        -->
        <TextView
            android:id="@+id/pass_widget_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:gravity="bottom|start"
            android:maxLines="2"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="600"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:hyphenationFrequency="normal"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="17sp"
            android:autoSizeStepGranularity="0.5sp"
            android:text="Ticket auswählen"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:id="@+id/pass_widget_issuer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="start"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.035"
            android:text="FossWallet"
            android:textColor="#FFCFE3EE"
            android:textSize="10sp" />

        <!-- Invisible id for the shared updater; RemoteViews supports TextView. -->
        <TextView
            android:id="@+id/pass_widget_caption"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
